# ── seo-blog-engine ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local. This .env.example only holds placeholders.
#
# Everything here is OPTIONAL. The blog engine renders, generates SEO/GEO
# schema, and builds with none of these set. They only switch on analytics
# and the email-capture lead flow described in docs/MEASUREMENT.md.

# ── Analytics (optional) ─────────────────────────────────────────
# Fathom Analytics (privacy-friendly). Site ID is public; the API key is not.
NEXT_PUBLIC_FATHOM_SITE_ID=XXXXXXXX
FATHOM_API_KEY=your_fathom_api_key_here

# Google Analytics 4 (optional alternative)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Email capture / lead flow (optional) ─────────────────────────
# Where the blog email-capture form POSTs. A Google Apps Script web app,
# a Zapier/Make webhook, your CRM endpoint — anything that accepts JSON.
LEAD_CAPTURE_WEBHOOK_URL=https://example.com/your-webhook-endpoint

# Optional: ping a Slack channel on each new lead.
LEAD_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX
